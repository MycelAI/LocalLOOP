    "node": "24.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/smoke.test.cjs",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:ci": "playwright test",
    "test:all": "node --test tests/smoke.test.cjs && bun run test:e2e",
    "check:domains": "node scripts/check-domains.cjs",
    "lint": "biome lint .",
    "typecheck": "tsc -p tests/tsconfig.json",
    "check": "bun run check:domains && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
