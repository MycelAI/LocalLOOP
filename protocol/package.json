{
  "name": "@local-loop/loop-protocol",
  "version": "0.6.0",
  "private": true,
  "description": "LOOP specification and schemas",
  "author": "Mycel UG (haftungsbeschränkt) <dev@mycel-ai.de>",
  "license": "(MIT AND CC-BY-SA-4.0)",
  "homepage": "https://loop.urbnia.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MycelAI/LocalLOOP.git",
    "directory": "protocol"
  },
  "bugs": {
    "url": "https://github.com/MycelAI/LocalLOOP/issues"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "check:domains": "bash scripts/check-domains.sh",
    "validate:schemas": "node scripts/validate-schemas.js",
    "conformance:core-dp": "node profiles/core-dp/conformance/run-conformance.js",
    "conformance:battery": "node profiles/battery/conformance/run-conformance.js",
    "conformance:packaging": "node profiles/packaging/conformance/run-conformance.js",
    "conformance:waste-shipment": "node profiles/waste-shipment/conformance/run-conformance.js",
    "check:schemas-readme": "node scripts/check-schemas-readme.js",
    "check:markers": "node scripts/check-agent-markers.js",
    "test": "npm run validate:schemas && npm run check:schemas-readme && npm run check:markers"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "overrides": {
    "fast-uri": "^4.1.5"
  }
